{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "every weekend"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Renovate Dependency Dashboard",
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates for stable dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^org\\.junit\\./",
        "/^org\\.mockito\\./",
        "/^org\\.assertj\\./",
        "/^org\\.slf4j\\./",
        "/^ch\\.qos\\.logback\\./",
        "/^com\\.h2database\\./",
        "/^org\\.hsqldb\\./",
        "/^org\\.postgresql\\./",
        "/^org\\.apache\\.commons\\./"
      ]
    },
    {
      "description": "Group all Gradle plugin updates together",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "/^com\\.github\\.spotbugs$/"
      ],
      "groupName": "Gradle plugins"
    },
    {
      "description": "Group all Jackson 3 dependencies together",
      "matchPackageNames": [
        "/^tools\\.jackson\\./"
      ],
      "groupName": "Jackson 3 dependencies"
    },
    {
      "description": "Separate major updates with manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "labels": ["dependencies", "github-actions"]
    },
    {
      "description": "Spring Boot dependencies - careful with major updates",
      "matchPackageNames": [
        "/^org\\.springframework\\./",
        "/^org\\.springframework\\.boot\\./"
      ],
      "labels": ["dependencies", "spring-boot"]
    },
    {
      "description": "Docker base image updates",
      "matchManagers": ["dockerfile"],
      "labels": ["dependencies", "docker"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "gradle": {
    "ignoreDeps": [
      "org.jspecify:jspecify"
    ]
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/test/**"
  ],
  "enabledManagers": [
    "gradle",
    "github-actions",
    "dockerfile"
  ]
}
